# Display name used in notifications and server-rendered pages.
APP_NAME="Weedy Classifieds"
# Base URL used by Laravel for absolute links. GitHub replaces this value in production.
APP_URL=http://localhost:8000
# Browser-visible application name. Never put secrets in VITE_ variables.
VITE_APP_NAME="${APP_NAME}"
# Runtime mode: local for development and production on the host.
APP_ENV=local
# Encryption key for cookies and encrypted data. Generate with php artisan key:generate.
APP_KEY=
# Shows detailed errors. Keep false in production.
APP_DEBUG=true
# Language used by the application, fallback translations, and Faker test data.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Stores maintenance-mode state in a local file. Use cache only for a shared cache setup.
APP_MAINTENANCE_DRIVER=file
# Cost factor for password hashing. Higher values are slower but more resistant to brute force attacks.
BCRYPT_ROUNDS=12
# Database driver and connection details.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=
DB_PASSWORD=
# Main log destination, stack members, deprecation destination, and minimum recorded severity.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Mail transport. log writes emails to Laravel logs locally; production normally uses SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# SMTP HELO/EHLO name. Leave blank unless the SMTP provider requires it.
MAIL_EHLO_DOMAIN=
# Default sender for all application emails.
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Recipient for messages sent from the in-app support form.
SUPPORT_MAIL_ADDRESS=
# Server-side fallback API key when a user has not supplied an OpenAI key.
OPENAI_API_KEY=
# ONNX clothing-detection model used by automatic image cropping.
AUTO_CROP_MODEL_PATH=storage/models/yolov8n-fashionpedia-1.onnx
# Python interpreter used for automatic image cropping.
PYTHON_PATH=.venv-crop/bin/python
# Additional Python-package directory used by automatic image cropping.
PYTHON_PACKAGES_PATH=
